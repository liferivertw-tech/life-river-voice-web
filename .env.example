# Copy to .env for the API. Docker Compose uses these defaults automatically.
DATABASE_URL="postgresql://life_river:life_river@127.0.0.1:55432/life_river?schema=public"
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"

# The deterministic provider works without any model key.
# Use "openai" after adding an API key. Without a key, the app safely falls back.
AI_PROVIDER="deterministic"
AI_MODEL="gpt-5.6-luna"
AI_API_KEY=""
TTS_MODEL="gpt-4o-mini-tts"
TTS_VOICE="marin"

# Copy NEXT_PUBLIC_API_URL to apps/web/.env.local when changing the API URL.
NEXT_PUBLIC_API_URL="http://localhost:4000"
