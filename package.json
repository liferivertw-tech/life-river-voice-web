{
  "name": "life-river-voice",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev -w @life-river/web\" \"npm run dev -w @life-river/api\"",
    "build": "npm run build -w @life-river/shared-types && npm run build -w @life-river/api && npm run build -w @life-river/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @life-river/api",
    "db:generate": "npm run db:generate -w @life-river/api",
    "db:migrate": "npm run db:migrate -w @life-river/api",
    "db:deploy": "npm run db:deploy -w @life-river/api",
    "db:studio": "npm run db:studio -w @life-river/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=20" }
}
